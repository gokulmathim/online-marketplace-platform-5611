---
import Layout from "../layouts/Layout.astro";
import { getCart, cartTotal, clearCart } from "../lib/cart";
import { checkout, getShippingRates } from "../lib/api";

const items = getCart();
const total = cartTotal();
---

<Layout>
  <section class="container">
    <h1 class="m-0">Checkout</h1>
    <p class="text-muted mt-2">Securely complete your purchase.</p>

    <div class="mt-4" style="display:grid;grid-template-columns:2fr 1fr;gap:16px;">
      <div class="flex-col" style="display:flex;gap:16px;">
        <!-- Shipping address -->
        <form id="shipping-form" class="card p-4">
          <h3 class="m-0">Shipping address</h3>
          <div class="grid mt-4" style="grid-template-columns: repeat(12, 1fr); gap: 12px;">
            <div style="grid-column: span 12;">
              <label>Full name<input name="name" class="input mt-2" autocomplete="name" /></label>
            </div>
            <div style="grid-column: span 12;">
              <label>Address line 1<input name="line1" class="input mt-2" autocomplete="address-line1" required /></label>
            </div>
            <div style="grid-column: span 12;">
              <label>Address line 2 (optional)<input name="line2" class="input mt-2" autocomplete="address-line2" /></label>
            </div>
            <div style="grid-column: span 6;">
              <label>City<input name="city" class="input mt-2" autocomplete="address-level2" required /></label>
            </div>
            <div style="grid-column: span 6;">
              <label>State/Province<input name="state" class="input mt-2" autocomplete="address-level1" /></label>
            </div>
            <div style="grid-column: span 6;">
              <label>Postal code<input name="postalCode" class="input mt-2" autocomplete="postal-code" required /></label>
            </div>
            <div style="grid-column: span 6;">
              <label>Country<input name="country" class="input mt-2" autocomplete="country" placeholder="US" required /></label>
            </div>
          </div>
          <div class="mt-3" style="display:flex;gap:8px;align-items:center;">
            <button id="get-rates" class="button" type="button">Get shipping rates</button>
            <span id="rates-status" class="text-muted"></span>
          </div>
        </form>

        <!-- Shipping options -->
        <div class="card p-4">
          <h3 class="m-0">Shipping method</h3>
          <div id="shipping-options" class="mt-3" style="display:flex;flex-direction:column;gap:8px;">
            <div class="text-muted">Enter your address and click "Get shipping rates".</div>
          </div>
        </div>

        <!-- Payment -->
        <form id="payment-form" class="card p-4">
          <h3 class="m-0">Payment details</h3>
          <div class="grid mt-4" style="grid-template-columns: repeat(12, 1fr); gap: 12px;">
            <div style="grid-column: span 12;">
              <label>Cardholder name<input name="name" class="input mt-2" required /></label>
            </div>
            <div style="grid-column: span 12;">
              <label>Card number<input name="number" inputmode="numeric" class="input mt-2" placeholder="4242 4242 4242 4242" required /></label>
            </div>
            <div style="grid-column: span 6;">
              <label>Expiry<input name="expiry" class="input mt-2" placeholder="MM/YY" required /></label>
            </div>
            <div style="grid-column: span 6;">
              <label>CVC<input name="cvc" class="input mt-2" placeholder="CVC" required /></label>
            </div>
            <div style="grid-column: span 12;">
              <label>Billing address (optional)<input name="address" class="input mt-2" /></label>
            </div>
          </div>
          <button id="pay-btn" class="button mt-4" type="submit">Pay ${total.toFixed(2)}</button>
          <div id="pay-msg" class="text-muted mt-3"></div>
        </form>
      </div>

      <aside class="card p-4">
        <h3 class="m-0">Order summary</h3>
        <div id="sum-items" class="mt-3" style="display:flex;flex-direction:column;gap:8px;"></div>
        <div class="flex justify-between mt-4">
          <span class="text-muted">Subtotal</span>
          <strong id="subtotal-amt">${total.toFixed(2)}</strong>
        </div>
        <div class="flex justify-between mt-2">
          <span class="text-muted">Shipping</span>
          <strong id="shipping-amt">--</strong>
        </div>
        <div class="flex justify-between mt-4" style="border-top:1px solid var(--border);padding-top:12px;">
          <span>Total</span>
          <strong id="total-amt">${total.toFixed(2)}</strong>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  import { getCart, clearCart } from "../lib/cart";
  import { checkout, getShippingRates } from "../lib/api";

  const summary = document.getElementById("sum-items");
  const paymentForm = document.getElementById("payment-form") as HTMLFormElement | null;
  const shippingForm = document.getElementById("shipping-form") as HTMLFormElement | null;
  const msg = document.getElementById("pay-msg");
  const ratesStatus = document.getElementById("rates-status");
  const optionsEl = document.getElementById("shipping-options");
  const payBtn = document.getElementById("pay-btn") as HTMLButtonElement | null;

  const shippingAmtEl = document.getElementById("shipping-amt");
  const totalAmtEl = document.getElementById("total-amt");
  const subtotalAmtEl = document.getElementById("subtotal-amt");

  let selectedOption: any = null;
  let shippingOptions: any[] = [];
  let subtotal = getCart().reduce((sum, ci) => sum + ci.product.price * ci.quantity, 0);

  function updateTotals() {
    if (!subtotalAmtEl || !totalAmtEl || !payBtn) return;
    const ship = selectedOption ? selectedOption.amount : 0;
    const total = subtotal + ship;
    if (shippingAmtEl) shippingAmtEl.textContent = selectedOption ? `$${ship.toFixed(2)}` : "--";
    subtotalAmtEl.textContent = `$${subtotal.toFixed(2)}`;
    totalAmtEl.textContent = `$${total.toFixed(2)}`;
    payBtn.textContent = `Pay ${total.toFixed(2)}`;
    payBtn.disabled = getCart().length === 0 || !selectedOption;
  }

  function renderSummary() {
    const items = getCart();
    if (!summary) return;
    summary.innerHTML = "";
    if (!items.length) {
      summary.textContent = "Your cart is empty.";
      return;
    }
    items.forEach((ci) => {
      const row = document.createElement("div");
      row.className = "flex justify-between";
      row.innerHTML = `<span>${ci.product.name} × ${ci.quantity}</span><strong>$${(ci.product.price * ci.quantity).toFixed(2)}</strong>`;
      summary.appendChild(row);
    });
  }

  function collectAddress() {
    if (!shippingForm) return null;
    const f = new FormData(shippingForm);
    const address = {
      name: String(f.get("name") || ""),
      line1: String(f.get("line1") || ""),
      line2: String(f.get("line2") || ""),
      city: String(f.get("city") || ""),
      state: String(f.get("state") || ""),
      postalCode: String(f.get("postalCode") || ""),
      country: String(f.get("country") || ""),
    };
    if (!address.line1 || !address.city || !address.postalCode || !address.country) {
      return null;
    }
    try {
      localStorage.setItem("shipping_address", JSON.stringify(address));
    } catch {}
    return address;
  }

  function renderOptions(options: any[]) {
    if (!optionsEl) return;
    optionsEl.innerHTML = "";
    if (!options.length) {
      const empty = document.createElement("div");
      empty.className = "text-muted";
      empty.textContent = "No shipping options available for the provided address.";
      optionsEl.appendChild(empty);
      selectedOption = null;
      updateTotals();
      return;
    }
    options.forEach((opt, idx) => {
      const row = document.createElement("label");
      row.className = "card p-3";
      row.style.display = "grid";
      row.style.gridTemplateColumns = "auto 1fr auto";
      row.style.alignItems = "center";
      row.style.gap = "12px";
      row.innerHTML = `
        <input type="radio" name="shipOpt" value="${opt.id}" ${idx === 0 ? "checked" : ""}/>
        <div>
          <strong>${opt.label}</strong>
          <div class="text-muted">${opt.carrier} · ${opt.service} · ETA ${opt.estimatedDays} days</div>
        </div>
        <div><strong>$${opt.amount.toFixed(2)}</strong></div>
      `;
      optionsEl.appendChild(row);
    });
    // default select first
    selectedOption = options[0];
    updateTotals();

    optionsEl.querySelectorAll('input[name="shipOpt"]').forEach((input) => {
      input.addEventListener("change", (e) => {
        const id = (e.target as HTMLInputElement).value;
        const found = options.find((o) => o.id === id);
        if (found) {
          selectedOption = found;
          updateTotals();
        }
      });
    });
  }

  async function loadRates() {
    const address = collectAddress();
    if (!address) {
      if (ratesStatus) ratesStatus.textContent = "Please complete required address fields.";
      return;
    }
    const cart = getCart();
    if (!cart.length) {
      if (ratesStatus) ratesStatus.textContent = "Cart is empty.";
      return;
    }
    if (ratesStatus) ratesStatus.textContent = "Fetching rates...";
    try {
      const itemsPayload = cart.map((ci) => ({
        productId: ci.product.id,
        quantity: ci.quantity,
        price: ci.product.price,
      }));
      const options = await getShippingRates({
        destination: address,
        cart: itemsPayload,
        subtotal,
      });
      shippingOptions = Array.isArray(options) ? options : [];
      renderOptions(shippingOptions);
      if (ratesStatus) ratesStatus.textContent = shippingOptions.length ? "Rates loaded." : "No rates available.";
    } catch (err) {
      console.warn("Failed to get rates", err);
      if (ratesStatus) ratesStatus.textContent = "Failed to load rates.";
    }
  }

  function restoreAddress() {
    try {
      const raw = localStorage.getItem("shipping_address");
      if (!raw || !shippingForm) return;
      const saved = JSON.parse(raw);
      const nameEl = shippingForm.querySelector('[name="name"]') as HTMLInputElement | null;
      if (nameEl) nameEl.value = saved.name || "";
      const line1El = shippingForm.querySelector('[name="line1"]') as HTMLInputElement | null;
      if (line1El) line1El.value = saved.line1 || "";
      const line2El = shippingForm.querySelector('[name="line2"]') as HTMLInputElement | null;
      if (line2El) line2El.value = saved.line2 || "";
      const cityEl = shippingForm.querySelector('[name="city"]') as HTMLInputElement | null;
      if (cityEl) cityEl.value = saved.city || "";
      const stateEl = shippingForm.querySelector('[name="state"]') as HTMLInputElement | null;
      if (stateEl) stateEl.value = saved.state || "";
      const postalEl = shippingForm.querySelector('[name="postalCode"]') as HTMLInputElement | null;
      if (postalEl) postalEl.value = saved.postalCode || "";
      const countryEl = shippingForm.querySelector('[name="country"]') as HTMLInputElement | null;
      if (countryEl) countryEl.value = saved.country || "";
    } catch {}
  }

  // Bind events
  document.getElementById("get-rates")?.addEventListener("click", loadRates);
  renderSummary();
  restoreAddress();
  updateTotals();

  paymentForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!selectedOption) {
      if (msg) msg.textContent = "Please select a shipping method.";
      return;
    }
    const pf = new FormData(paymentForm);
    const shippingAddress = collectAddress();
    if (!shippingAddress) {
      if (msg) msg.textContent = "Please provide a valid shipping address.";
      return;
    }

    const payment = {
      cardNumber: String(pf.get("number") || ""),
      expiry: String(pf.get("expiry") || ""),
      cvc: String(pf.get("cvc") || ""),
      name: String(pf.get("name") || ""),
      address: String(pf.get("address") || ""),
    };
    const items = getCart().map((ci) => ({ productId: ci.product.id, quantity: ci.quantity }));
    const res = await checkout({
      items,
      payment,
      shipping: { address: shippingAddress, option: selectedOption },
    });
    if (res?.orderId) {
      if (msg) msg.textContent = `Payment successful. Order ${res.orderId} created.`;
      clearCart();
      setTimeout(() => (location.href = "/orders"), 600);
    } else {
      if (msg) msg.textContent = "Payment failed. Please try again.";
    }
  });
</script>
