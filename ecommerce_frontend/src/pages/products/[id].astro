---
import Layout from "../../layouts/Layout.astro";
import { getProductById, searchProducts } from "../../lib/api";

export async function getStaticPaths() {
  // Prefetch a subset of products for static generation (works with demo fallback when API is not configured).
  const res = await searchProducts({ page: 1, pageSize: 50 });
  return res.items.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const product = await getProductById(id!);
---

<Layout>
  <section class="container">
    {product ? (
      <div class="card p-4" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
        <div>
          <div style="aspect-ratio: 1 / 1; background:#f3f4f6; overflow:hidden;border-radius:12px;">
            <img src={product.imageUrl || "https://placehold.co/800x800"} alt={product.name} style="width:100%;height:100%;object-fit:cover;" />
          </div>
        </div>
        <div>
          <h1 class="m-0">{product.name}</h1>
          <p class="text-muted mt-2">${product.price.toFixed(2)}</p>
          {product.description && <p class="mt-4">{product.description}</p>}
          <div class="mt-4" style="display:flex;gap:8px;">
            <button id="pd-add" class="button">Add to cart</button>
            <a href="/checkout" class="button ghost">Buy now</a>
          </div>
          <script id="pd-data" type="application/json">{JSON.stringify(product)}</script>
        </div>
      </div>
    ) : (
      <div class="card p-4">Product not found.</div>
    )}
  </section>
</Layout>

{product && (
  <script>
    import { addToCart } from "../../lib/cart";
    const btn = document.getElementById("pd-add");
    const dataEl = document.getElementById("pd-data");
    if (btn && dataEl) {
      const product = JSON.parse(dataEl.textContent || "{}");
      btn.addEventListener("click", () => addToCart(product, 1));
    }
  </script>
)}
