---
import type { Product } from "../lib/types";
const { product } = Astro.props as { product: Product };
---
<article class="card" style="overflow:hidden;display:flex;flex-direction:column;">
  <a href={`/products/${product.id}`} style="text-decoration:none;color:inherit;">
    <div style="aspect-ratio: 1/1; background:#f3f4f6; overflow:hidden;">
      <img src={product.imageUrl || "https://placehold.co/600x600"} alt={product.name} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
    </div>
    <div style="padding:12px;">
      <h3 style="margin:0;font-size:16px;line-height:1.3;">{product.name}</h3>
      <p class="text-muted mt-2" style="font-size:14px;">${product.price.toFixed(2)}</p>
    </div>
  </a>
  <div style="padding:12px;padding-top:0;display:flex;gap:8px;">
    <button class="button flex-1" data-add={product.id}>Add to cart</button>
    <a href={`/products/${product.id}`} class="button ghost">Details</a>
  </div>
</article>

<script>
  import { addToCart } from "../lib/cart";
  // Attach once per component render
  const btn = document.querySelector(`button[data-add="${Astro.props.product.id}"]`);
  if (btn) {
    btn.addEventListener("click", () => addToCart(Astro.props.product, 1));
  }
</script>
