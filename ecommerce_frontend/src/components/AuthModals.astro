---
---
<div id="auth-backdrop" class="hidden" style="position:fixed;inset:0;background:rgba(0,0,0,0.35);backdrop-filter:saturate(120%) blur(2px);z-index:60;"></div>

<div id="auth-modal" class="card hidden" style="position:fixed;inset:0;display:grid;place-items:center;z-index:61;background:transparent;">
  <div class="card" style="width:560px;max-width:calc(100vw - 32px);padding:20px;">
    <div class="flex items-center justify-between">
      <h3 class="m-0">Welcome back</h3>
      <button id="auth-close" class="button ghost">Close</button>
    </div>
    <p class="text-muted mt-2">Sign in or create an account to continue.</p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;">
      <form id="login-form" class="card p-4">
        <h4 class="m-0">Sign in</h4>
        <label class="mt-3">Email<input name="email" type="email" class="input mt-2" required /></label>
        <label class="mt-3">Password<input name="password" type="password" class="input mt-2" required /></label>
        <button class="button mt-4" type="submit">Sign in</button>
      </form>

      <form id="register-form" class="card p-4">
        <h4 class="m-0">Create account</h4>
        <label class="mt-3">Name<input name="name" type="text" class="input mt-2" required /></label>
        <label class="mt-3">Email<input name="email" type="email" class="input mt-2" required /></label>
        <label class="mt-3">Password<input name="password" type="password" class="input mt-2" required /></label>
        <button class="button secondary mt-4" type="submit">Register</button>
      </form>
    </div>

    <div id="auth-msg" class="text-muted mt-4"></div>
  </div>
</div>

<script>
  import { login, register } from "../lib/api";
  import { setAuth } from "../lib/auth";

  const backdrop = document.getElementById("auth-backdrop");
  const modal = document.getElementById("auth-modal");
  const closeBtn = document.getElementById("auth-close");
  const loginForm = document.getElementById("login-form") as HTMLFormElement | null;
  const registerForm = document.getElementById("register-form") as HTMLFormElement | null;
  const msg = document.getElementById("auth-msg");

  function show() {
    backdrop?.classList.remove("hidden");
    modal?.classList.remove("hidden");
  }
  function hide() {
    backdrop?.classList.add("hidden");
    modal?.classList.add("hidden");
    if (msg) msg.textContent = "";
  }

  window.addEventListener("auth:open", show as any);
  backdrop?.addEventListener("click", hide);
  closeBtn?.addEventListener("click", hide);

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(loginForm);
    const email = String(data.get("email") || "");
    const password = String(data.get("password") || "");
    const res = await login(email, password);
    if (res?.token) {
      setAuth(res.token, res.user);
      if (msg) msg.textContent = "Signed in successfully!";
      setTimeout(hide, 400);
    } else {
      if (msg) msg.textContent = "Sign in failed. Please check your credentials.";
    }
  });

  registerForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(registerForm);
    const name = String(data.get("name") || "");
    const email = String(data.get("email") || "");
    const password = String(data.get("password") || "");
    const res = await register(name, email, password);
    if (res?.token) {
      setAuth(res.token, res.user);
      if (msg) msg.textContent = "Account created and signed in!";
      setTimeout(hide, 400);
    } else {
      if (msg) msg.textContent = "Registration failed. Try a different email.";
    }
  });
</script>
